# -----------------------------------------------------------------------------
# TrustCall / VoiceShield — Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT commit real secrets or production keys to version control.
# -----------------------------------------------------------------------------

# Application Settings
TRUSTCALL_APP_NAME="TrustCall / VoiceShield"
TRUSTCALL_APP_VERSION="1.0.0"
TRUSTCALL_DEBUG=true

# Security & Cryptographic Salts
# Replace with a cryptographically strong 64-character random string in production
TRUSTCALL_SALT_KEY="trustcall_sih2024_irreversible_salt_vector"
TRUSTCALL_WEBHOOK_SECRET="trustcall_default_webhook_hmac_secret_key"
TRUSTCALL_WEBHOOK_TIMESTAMP_TOLERANCE_SEC=300

# API Key Authentication
# Set to true to enforce X-API-Key header verification on sensitive routes
TRUSTCALL_API_KEY_AUTH_ENABLED=false
# Comma-separated list or JSON list of valid API keys
TRUSTCALL_API_KEYS='["trustcall-admin-key-2024","trustcall-demo-key-2024"]'

# CORS Origins (Restricted in production)
TRUSTCALL_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","https://trivikram-the-techie.github.io"]'

# Rate Limiting (Requests per minute per IP / API key)
TRUSTCALL_RATE_LIMIT_SCORE_PER_MIN=60
TRUSTCALL_RATE_LIMIT_REDTEAM_PER_MIN=20
TRUSTCALL_RATE_LIMIT_STREAM_PER_MIN=30

# File Upload & Audio Constraints
TRUSTCALL_MAX_UPLOAD_SIZE_BYTES=15728640   # 15 MB in bytes
TRUSTCALL_MAX_AUDIO_DURATION_SEC=120.0      # 120 seconds maximum per audio file
TRUSTCALL_ALLOWED_AUDIO_MIME_TYPES='["audio/wav","audio/x-wav","audio/wave","audio/mpeg","audio/mp3","audio/ogg","audio/flac","audio/webm","audio/x-m4a","audio/mp4","audio/aac"]'

# Audio Processing Specs
TRUSTCALL_SAMPLE_RATE=16000
TRUSTCALL_CHUNK_DURATION_SEC=0.25
TRUSTCALL_ANALYSIS_WINDOW_SEC=1.5
TRUSTCALL_OVERLAP_RATIO=0.5

# Two-Stage Cascade & Scalability Settings
TRUSTCALL_ENABLE_CASCADE=true
TRUSTCALL_CASCADE_STAGE1_THRESHOLD=0.35
TRUSTCALL_CASCADE_PERIODIC_INTERVAL=10
TRUSTCALL_CASCADE_FAIL_OPEN_TIMEOUT_MS=150.0
TRUSTCALL_SESSION_STORE_BACKEND="memory"   # "memory" or "redis"
TRUSTCALL_REDIS_URL="redis://localhost:6379/0"

# Multi-Signal Risk Fusion Weights (Must sum to 1.0)
TRUSTCALL_WEIGHT_SPOOF_MODEL=0.45
TRUSTCALL_WEIGHT_SPECTRAL_FLUX=0.15
TRUSTCALL_WEIGHT_PROSODIC=0.15
TRUSTCALL_WEIGHT_URGENCY_NLP=0.15
TRUSTCALL_WEIGHT_CALLER_META=0.10

# Metadata Reputation Sub-Weights (Must sum to 1.0)
TRUSTCALL_META_WEIGHT_NUMBER_REPUTATION=0.35
TRUSTCALL_META_WEIGHT_CALL_BURST_VELOCITY=0.25
TRUSTCALL_META_WEIGHT_SHORT_REPEAT_CALLS=0.20
TRUSTCALL_META_WEIGHT_VOIP_PREFIX=0.20
